# Copy to .env and adjust as needed:  cp .env.example .env

# --- Postgres (matches docker-compose.yml) ---
DATABASE_URL=postgresql://raguser:ragpass@localhost:55432/ragdb

# --- Embeddings (local, no API key) ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384

# --- LLM provider: "ollama" (local, default) or "groq" (free API) ---
LLM_PROVIDER=ollama

# Used when LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2

# Used when LLM_PROVIDER=groq — get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
